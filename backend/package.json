{
  "name": "vio-live-backend",
  "private": true,
  "version": "0.19.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prepare:local-chat": "node scripts/prepare-local-chat-profile.js",
    "export:local-chat-binding": "node scripts/export-local-chat-binding.js",
    "prepare:live-chat": "node scripts/prepare-live-chat.js",
    "doctor:live-chat": "node scripts/doctor-live-chat.js",
    "create:live-chat-sandbox": "node scripts/create-live-chat-sandbox.js",
    "cleanup:live-chat-sandbox": "node scripts/cleanup-live-chat-sandbox.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:continuity-shared": "node --test shared-tests/continuity-integration-shared.test.js",
    "test:continuity-capability-shared": "node --test shared-tests/continuity-capability-local-http-shared.test.js",
    "test:continuity-conversation-shared": "node --test shared-tests/continuity-conversation-local-http-shared.test.js"
  }
}
